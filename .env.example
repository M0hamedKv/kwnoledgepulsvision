# SMTP settings shared by the contact and Join Us forms.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contact form inbox (required for /Contact).
CONTACT_TO_EMAIL=
# Optional sender override; defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# Join Us form inbox. Falls back to CONTACT_TO_EMAIL when empty.
JOIN_TO_EMAIL=
